server {
    listen {{ webserver_port }} default_server;
    listen [::]:{{ webserver_port }} default_server;

    root /var/www/html;
    index index.html;

    server_name {{ inventory_hostname }};

    location / {
        try_files $uri $uri/ =404;
    }

    location /health {
        access_log off;
        return 200 "ok\n";
    }
}
